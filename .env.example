# ── Database ────────────────────────────────────────────────
# MongoDB connection string (MONGO_DIRECT_URI takes precedence if set)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# MONGO_DIRECT_URI=

# ── Auth ────────────────────────────────────────────────────
# Long random string used to sign admin sessions, e.g. `openssl rand -hex 32`
JWT_SECRET=

# ── Site ────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Base URL used in password-reset emails (defaults to NEXT_PUBLIC_SITE_URL)
FRONTEND_URL=https://your-domain.com

# ── Image uploads (Cloudinary) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Password-reset email (SMTP) ─────────────────────────────
# Required in production; in development an Ethereal test inbox is used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio Admin <no-reply@your-domain.com>"

# ── Contact form (EmailJS, public browser keys) ─────────────
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
